---
import Base from "../layouts/Base.astro";
import About from "../components/About.astro";
import Theory from "../content/theory.mdx";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const sections = [
  ["the-problem", "The problem"],
  ["the-material", "The material"],
  ["correspondence", "Correspondence"],
  ["one-elastic-problem-per-state", "One elastic problem per state"],
  ["what-changes-between-states", "What changes between states"],
  ["one-mollification-width", "One mollification width"],
  ["poles", "Poles"],
  ["back-to-time", "Back to time"],
  ["the-weights-of-a-time", "The weights of a time"],
  ["earthquakes-that-repeat", "Earthquakes that repeat"],
  ["gravity", "Gravity"],
  ["the-walls", "The walls"],
  ["two-meshes", "Two meshes"],
  ["a-fault-that-creeps", "A fault that creeps"],
  ["stress-and-the-interior", "Stress, and the interior"],
  ["what-it-is-held-to", "What it is held to"],
  ["beyond-linearity", "Beyond linearity"],
  ["references", "References"],
];
---
<Base
  title="ve — Theory"
  description="The theory behind viscoelastic earthquake cycles on boundaries alone: correspondence, the elastic problem at each Laplace state, the inversion to time by collocation, repeating earthquakes, gravity, window walls, the two-mesh limit and a fault that creeps."
  current="theory"
>
  <Fragment slot="sidebar">
    <h1>Theory<span class="sub">the derivation, in order</span></h1>
    <p>
      <a href={`${base}concepts/`}>Concepts</a> says what the models do and
      what to trust. This page derives it: why a relaxing Earth is an elastic
      one at each value of the Laplace variable, what changes between those
      elastic problems and what does not, and how fourteen of them become a
      function of time.
    </p>
    <nav class="toc" aria-label="Contents">
      <h3>Contents</h3>
      <ol>
        {sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      </ol>
    </nav>
    <hr />
    <About />
  </Fragment>

  <Theory />
</Base>
